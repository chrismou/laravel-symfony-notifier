{
    "name": "chrismou/laravel-symfony-notifier",
    "description": "Symfony Notifier for Laravel: chat and SMS notification channels for every Notifier bridge (Slack, Discord, Telegram, Microsoft Teams, Twilio and more), configured by DSN, with requests sent through Laravel's HTTP client so Http::fake() works.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "symfony",
        "notifier",
        "notifications",
        "chat",
        "sms",
        "slack",
        "discord",
        "telegram",
        "microsoft-teams",
        "twilio",
        "http-client"
    ],
    "authors": [
        {
            "name": "Chris Chrisostomou",
            "email": "dev@mou.me",
            "homepage": "https://mou.me"
        }
    ],
    "support": {
        "source": "https://github.com/chrismou/laravel-symfony-notifier",
        "issues": "https://github.com/chrismou/laravel-symfony-notifier/issues",
        "docs": "https://github.com/chrismou/laravel-symfony-notifier/blob/main/README.md"
    },
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8 || ^8.0",
        "illuminate/container": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/events": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/notifications": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "psr/http-message": "^1.1 || ^2.0",
        "symfony/event-dispatcher-contracts": "^2.5 || ^3.0",
        "symfony/http-client-contracts": "^3.4",
        "symfony/notifier": "^7.4 || ^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "symfony/discord-notifier": "^7.4 || ^8.0",
        "symfony/microsoft-teams-notifier": "^7.4.14 || ~8.0.14 || ^8.1.1",
        "symfony/rocket-chat-notifier": "^7.4 || ^8.0",
        "symfony/slack-notifier": "^7.4 || ^8.0",
        "symfony/telegram-notifier": "^7.4 || ^8.0",
        "symfony/twilio-notifier": "^7.4 || ^8.0"
    },
    "suggest": {
        "symfony/slack-notifier": "Slack chat transport (slack://)",
        "symfony/discord-notifier": "Discord chat transport (discord://)",
        "symfony/telegram-notifier": "Telegram chat transport (telegram://)",
        "symfony/microsoft-teams-notifier": "Microsoft Teams chat transport (microsoftteams://)",
        "symfony/twilio-notifier": "Twilio SMS transport (twilio://)"
    },
    "autoload": {
        "psr-4": {
            "Chrismou\\LaravelSymfonyNotifier\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Chrismou\\LaravelSymfonyNotifier\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Chrismou\\LaravelSymfonyNotifier\\NotifierServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text",
        "lint": "pint --test",
        "lint:fix": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
